# --- Speech: Sarvam on both sides -------------------------------------------
# saaras:v3 streaming STT and bulbul:v3 streaming TTS.
SARVAM_API_KEY=
SARVAM_MODE=transcribe
# Unset (or "auto") = detect the caller's language on every utterance; the voice
# follows it (Hindi, English, Marathi, Tamil, Telugu, Bengali, Gujarati, Kannada,
# Malayalam, Punjabi, Odia). Set e.g. hi-IN to pin one language.
# SARVAM_LANGUAGE=auto
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
# The voice language until the caller's language is detected.
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_PACE=1.05
SARVAM_TTS_MAX_CHUNK_LENGTH=120
# Not sent for bulbul:v3 — Sarvam's live websocket rejects it. See sarvam_tts.py.
SARVAM_TTS_MIN_BUFFER_SIZE=20

# --- The LLM: any OpenAI-compatible endpoint ---------------------------------
# The OPENAI_* names are kept because every OpenAI-compatible gateway reads them.
# With the base URL below this is OpenRouter, so the key is an OpenRouter key
# (sk-or-v1-...), not an OpenAI one.
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_TEMPERATURE=0.4
# Cap on reply length. On a phone call this is a latency control, not a cost
# one: every extra sentence is the customer listening instead of answering.
OPENAI_MAX_COMPLETION_TOKENS=180
#
# `openrouter/free` routes each request to a randomly chosen free model, and free
# models are rate-limited to 20 requests/minute and 50/day (1,000/day once $10 of
# credits have been purchased). Every reply in a call is one request, so this is
# enough to try the agent out, not to run a campaign. For production, name a
# specific model — the same one every turn, so the persona and the Hinglish stay
# consistent. Pick a fast, non-reasoning one from https://openrouter.ai/models:
# reasoning models think before the first word, and on a phone call that is dead air.
# SYSTEM_PROMPT=You are a helpful voice assistant. Always reply in Hinglish using Roman script only.

# --- Turn-taking: Silero VAD, run locally ------------------------------------
# Silero decides when the caller starts and stops talking; Sarvam's own VAD is
# switched off so the two never disagree. Defaults are Pipecat's.
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
# Raise this if line noise or a TV in the background keeps interrupting the bot.
VAD_MIN_VOLUME=0.6
# Pause allowed before the caller's turn counts as finished. The bot starts
# answering after roughly VAD_STOP_SECS + USER_TURN_SILENCE_SECS of silence.
USER_TURN_SILENCE_SECS=0.6
# Whether the caller can talk over the bot. The bot's first reply is always
# protected from interruption either way. false = never interruptible.
BARGE_IN=true
# CRM calls open with a greeting naming the business (every organisation shares one
# Vobiz number). Seconds between pickup and that greeting.
GREETING_DELAY_SECS=0.6

# --- Vobiz --------------------------------------------------------------------
PUBLIC_BASE_URL=https://your-public-url.example.com
# VOBIZ_WS_URL=wss://your-public-url.example.com/vobiz/ws
VOBIZ_STREAM_CONTENT_TYPE=audio/x-l16;rate=16000

# --- CRM integration --------------------------------------------------------
# bcrm-backend always occupies host port 8000. This voice agent is on 8100.
# BCRM_BASE_URL is the CRM origin as THIS process can reach it — that is :8000,
# never 8100. Leave both blank and the agent still answers; it just cannot
# fetch scripts or report outcomes.
#
# Same EC2, two Compose stacks (the production layout):
#   BCRM_BASE_URL=http://<ec2-private-ip>:8000
# Inside this container, 127.0.0.1 is the voice agent itself, not the CRM.
BCRM_BASE_URL=http://172.31.91.110:8000
# Must match INTERNAL_API_TOKEN in the bcrm-backend .env.
INTERNAL_API_TOKEN=

# Hard ceiling on simultaneous calls THIS process accepts; the answer URL hangs
# up politely on the one that goes over. Measure it — the binding constraint is
# whichever of Pipecat CPU, the LLM gateway's rate limit and the Vobiz account's
# concurrency cap is lowest. On openrouter/free that is the 20 requests/minute:
# a talking customer produces a request every ~5-10 seconds, so 2 calls at most.
MAX_CONCURRENT_CALLS=10

# Post-call summary, sent once the call has ended. Uses the same key and gateway
# as the conversation. Leave CALL_SUMMARY_MODEL unset to use OPENAI_MODEL — a
# model id only means something to the gateway it was written for.
CALL_SUMMARY_ENABLED=true
# CALL_SUMMARY_MODEL=

LOG_LEVEL=INFO
