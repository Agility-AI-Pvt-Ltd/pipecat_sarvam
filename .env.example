OPENAI_API_KEY=
PUBLIC_BASE_URL=https://your-public-url.example.com

# Optional overrides
# VOBIZ_WS_URL=wss://your-public-url.example.com/vobiz/ws
VOBIZ_STREAM_CONTENT_TYPE=audio/x-l16;rate=16000

# OpenAI Realtime speech-to-speech
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_NOISE_REDUCTION=near_field
OPENAI_REALTIME_VAD_THRESHOLD=0.65
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=500
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=700
OPENAI_MAX_COMPLETION_TOKENS=180
# SYSTEM_PROMPT=You are a helpful voice assistant. Always reply in Hinglish using Roman script only.

# --- CRM integration --------------------------------------------------------
# Where to report call outcomes. Both may be left blank: the agent still answers
# calls, it just has nowhere to send the transcript.
BCRM_BASE_URL=http://api:8000
# Must match INTERNAL_API_TOKEN in the bcrm-backend .env.
INTERNAL_API_TOKEN=

# Hard ceiling on simultaneous calls THIS process accepts; the answer URL hangs
# up politely on the one that goes over. Measure it — the binding constraint is
# whichever of Pipecat CPU, the AI provider's rate limits and the Vobiz account's
# concurrency cap is lowest on your hardware. Watch /metrics while load testing.
MAX_CONCURRENT_CALLS=10

# Post-call summarisation, run after the socket closes so it never competes with
# the live Realtime session. Uses OPENAI_API_KEY.
CALL_SUMMARY_ENABLED=true
CALL_SUMMARY_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Legacy Sarvam cascade settings. Not used by the active OpenAI Realtime pipeline.
SARVAM_API_KEY=
SARVAM_MODE=transcribe
# SARVAM_LANGUAGE=HI_IN
SARVAM_VAD_SIGNALS=true
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_PACE=1.05
SARVAM_TTS_MAX_CHUNK_LENGTH=120

LOG_LEVEL=INFO
